<div class="btns" role="tablist" aria-label="主题切换">
  <input type="radio" name="theme" id="t-light" />
  <input type="radio" name="theme" id="t-auto" />
  <input type="radio" name="theme" id="t-dark" />
  <div class="check" aria-hidden="true"></div>
  <label for="t-light" class="i-sun"></label>
  <label for="t-auto" class="i-desktop"></label>
  <label for="t-dark" class="i-moon"></label>
</div>

<style>
  /* 分段开关容器 */
  .btns {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 142px;
    height: 50px;
    font-size: 24px;
    border: 2px solid var(--main);
    border-radius: 12px;
    user-select: none;
  }

  .btns > input {
    display: none;
  }

  /* 标签（按钮）样式 */
  .btns > label {
    flex: 1;
    padding: 10px;
    text-align: center;
    cursor: pointer;
    z-index: 1;
  }

  /* 滑动指示器 */
  .check {
    position: absolute;
    width: 46px;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.2, 1);
    background: radial-gradient(var(--bg), var(--main));
    border-radius: 8px;
  }

  /* 指示器移动（三种状态） */
  #t-light:checked ~ .check {
    transform: translateX(0%);
  }
  #t-auto:checked ~ .check {
    transform: translateX(100%);
  }
  #t-dark:checked ~ .check {
    transform: translateX(200%);
  }
</style>

<script>
  document.querySelectorAll('input[name="theme"]').forEach((r) => {
    r.addEventListener("change", () => {
      const mode = r.id.slice(2) // 移除 t- 前缀
      document.documentElement.setAttribute("data-theme", mode)
      localStorage.setItem("theme", mode)
    })
  })
</script>
